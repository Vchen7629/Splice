# build from go_services/:
#   docker build -f cmd/gateway/dockerfile -t gateway .
# Need to override env vars if running in seperate docker containers
#   docker run \
#   -p 8080:8080 \
#   --add-host=host.docker.internal:host-gateway \
#    -e SCENE_DETECTOR_URL=http://scene-detector:9098 \
#    -e TRANSCODER_URL=http://host.docker.internal:9095 \
#    -e RECOMBINER_URL=http://host.docker.internal:9090
#    -e VIDEO_UPSCALING_URL=http://host.docker.internal:9101 \
#    -e BASE_STORAGE_URL=http://host.docker.internal:8888 \
#    -e NATS_URL=nats://host.docker.internal:4222 \
#    gateway:latest
# or just use the docker-compose.backend.yaml to run all services
FROM golang:1.27.2-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY cmd/gateway ./cmd/gateway
COPY internal ./internal
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
      CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/gateway ./cmd/gateway

FROM alpine:3.24

RUN apk add --no-cache ffmpeg 
RUN adduser -D -u 1000 app

COPY --from=builder /out/gateway /usr/local/bin/gateway

USER app

EXPOSE 8080

CMD ["gateway"]