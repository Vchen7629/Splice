# build from go_services/:
#   docker build -f cmd/chunkworker/dockerfile -t chunkworker .
# probably need to override BaseStorageURL if running in seperate docker containers
#   docker run \
#   -p 9095:9095 \
#   --add-host=host.docker.internal:host-gateway \
#    -e BASE_STORAGE_URL=http://host.docker.internal:8888 \
#    -e NATS_URL=nats://host.docker.internal:4222 \
#    chunkworker:latest
# or just use the docker-compose.backend.yaml to run all services
FROM golang:1.27.3-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY cmd/chunkworker ./cmd/chunkworker
COPY internal ./internal
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
      CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/chunkworker ./cmd/chunkworker

FROM alpine:3.24

RUN apk add --no-cache ffmpeg 
RUN adduser -D -u 1000 app

COPY --from=builder /out/chunkworker /usr/local/bin/chunkworker

USER app

# for gateway health checking
EXPOSE 9095

CMD ["chunkworker"]